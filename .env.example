PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/lia?sslmode=disable
# Both secrets below must be 32 random bytes, base64-encoded (e.g. `head -c 32 /dev/urandom | base64`).
# Never derive these from a memorable phrase/passphrase, even hashed — a hash of low-entropy
# input is still low-entropy. Generate with a real CSPRNG, always.
JWT_SECRET=change-me
# Used to encrypt secrets at rest (groq_api_key_encrypted) — separate from JWT_SECRET on purpose.
ENCRYPTION_KEY=change-me

# Used by docker-compose to provision the postgres container.
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=lia
